// SOBapp Platform Database Schema
// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  hashedPassword String
  role           String   @default("user") // user, manager, admin
  userRole       UserRole @default(LANDLORD)
  company        String?
  phone          String?
  subscription   String   @default("free") // free, starter, professional, enterprise
  stripeCustomerId String? @unique
  hasSignedAgreement Boolean @default(false)

  // Permissions
  permissions    String   @default("[]") // JSON array of permission strings

  // Metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastLoginAt    DateTime?
  isActive       Boolean  @default(true)

  // Relations
  networks       Network[]
  analyses       Analysis[]
  scenarios      Scenario[]
  sessions       Session[]
  apiKeys        ApiKey[]
  waterAudits    WaterAudit[]

  @@index([email])
  @@index([role])
  @@index([subscription])
  @@index([hasSignedAgreement])
  @@index([isActive, role])
}

enum UserRole {
  LANDLORD
  TENANT
}

model EnvironmentalPermit {
  id             String   @id @default(cuid())
  propertyNodeId String
  permitType     String   // dental, medical, environmental, etc.
  description    String?
  issuedAt       DateTime?
  isHistorical   Boolean  @default(true)
  metadata       String?  // JSON
  createdAt      DateTime @default(now())

  @@index([propertyNodeId])
  @@index([permitType])
  @@index([isHistorical])
}

model WaterAudit {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meterReadCurrent Float
  meterReadLast Float
  totalBill     Float
  serviceCharge Float?
  sewerCharge   Float?
  expectedBill  Float?
  discrepancyAmount Float?
  errorPercentage Float?
  severity      String?
  recommendation String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([userId, expires])
  @@index([expires])
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsed  DateTime?
  expiresAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([key])
  @@index([userId, isActive])
  @@index([isActive, expiresAt])
}

// ============================================
// NETWORK & ANALYSIS
// ============================================

model Network {
  id          String   @id @default(cuid())
  name        String
  description String?
  nodes       String   // JSON
  edges       String   // JSON
  metadata    String?  // JSON

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses    Analysis[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, updatedAt])
  @@index([userId, createdAt])
}

model Analysis {
  id         String   @id @default(cuid())
  networkId  String
  network    Network  @relation(fields: [networkId], references: [id], onDelete: Cascade)

  type       String   // centrality, community_detection, path_analysis, etc.
  algorithm  String   // pagerank, betweenness, louvain, etc.
  parameters String   // JSON
  results    String?  // JSON
  status     String   @default("pending") // pending, running, completed, failed
  error      String?

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([networkId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@index([networkId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ============================================
// SUPPLY CHAIN & SCENARIOS
// ============================================

model Scenario {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // baseline, high_demand, constrained_supply, rapid_expansion

  parameters  String   // JSON: materials, technologies, timeHorizon, etc.
  results     String?  // JSON: objectiveValue, feasibility, costs, metrics
  status      String   @default("pending") // pending, running, completed, failed
  error       String?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([type, status])
  @@index([status, createdAt])
}

// ============================================
// MARKET DATA
// ============================================

model CommodityPrice {
  id        String   @id @default(cuid())
  symbol    String   // LIT, COB, NIC, etc.
  name      String   // Lithium, Cobalt, Nickel
  price     Float
  change    Float    // Percentage change
  volume    Float?
  high      Float?
  low       Float?
  open      Float?
  source    String   // yahoo_finance, alpha_vantage, etc.
  timestamp DateTime @default(now())

  @@index([symbol, timestamp])
  @@index([timestamp])
}

model RiskAlert {
  id          String   @id @default(cuid())
  severity    String   // low, medium, high, critical
  category    String   // supply_chain, geopolitical, price_volatility, etc.
  title       String
  description String
  region      String?
  commodity   String?
  impact      String?  // JSON: affected commodities, estimated impact

  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?  // userId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([severity, resolved])
  @@index([category])
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([resolved, createdAt])
  @@index([severity, createdAt])
}

model GeopoliticalEvent {
  id          String   @id @default(cuid())
  country     String
  region      String
  eventType   String   // policy_change, conflict, trade_restriction, etc.
  title       String
  description String
  severity    String   // low, medium, high, critical

  affectedCommodities String? // JSON array
  riskScore   Float?

  source      String
  sourceUrl   String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([country])
  @@index([region])
  @@index([severity])
  @@index([publishedAt])
  @@index([country, publishedAt])
  @@index([region, publishedAt])
  @@index([severity, publishedAt])
  @@index([eventType, publishedAt])
}

// ============================================
// AUDIT & COMPLIANCE
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // login, export, create_scenario, etc.
  resource    String   // user, scenario, network, etc.
  resourceId  String?
  details     String?  // JSON
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([resource, timestamp])
}

enum DealPropertyType {
  COMMERCIAL
  RESIDENTIAL
  MIXED
  EXEMPT
}

enum DealDecision {
  PROCEED
  CAUTION
  ESCALATE
  INSUFFICIENT
}

enum DealSubmittedBy {
  DEVELOPER
  INSTITUTIONAL
  ANONYMOUS
}

model DealRecord {
  id                String           @id @default(cuid())
  address           String
  zip_code          String?
  neighborhood      String?
  property_type     DealPropertyType?
  zoning_code       String?
  land_use          String?
  assessment_value  Int?
  owner_name        String?
  permit_count      Int              @default(0)
  permit_types      String[]         @default([])
  active_violations Int              @default(0)
  violation_types   String[]         @default([])
  vacant_notice     Boolean          @default(false)
  decision          DealDecision
  decision_drivers  String[]         @default([])
  submitted_by      DealSubmittedBy  @default(ANONYMOUS)
  institution_name  String?
  scan_timestamp    DateTime         @default(now())
  outcome_reported  Boolean          @default(false)
  outcome           String?
  outcome_reported_at DateTime?
  notes             String?

  @@index([scan_timestamp])
  @@index([decision, scan_timestamp])
  @@index([zip_code, scan_timestamp])
  @@index([property_type, scan_timestamp])
  @@index([institution_name, scan_timestamp])
}

enum PilotStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model PilotEngagement {
  id                 String      @id @default(cuid())
  institution_name   String      @unique
  contact_name       String
  contact_email      String
  pilot_start_date   DateTime    @default(now())
  pilot_status       PilotStatus @default(ACTIVE)
  deal_target        Int
  deals_submitted    Int         @default(0)
  deals_delivered    Int         @default(0)
  feedback_collected Boolean     @default(false)
  notes              String?

  @@index([pilot_status])
  @@index([pilot_start_date])
}

model PilotAccessToken {
  id               String   @id @default(cuid())
  token            String   @unique
  institution_name String
  contact_email    String
  created_at       DateTime @default(now())

  @@index([institution_name, created_at])
}

enum EngagementType {
  PILOT
  MONTHLY_RETAINER
  PER_DEAL
  CUSTOM
}

enum ClientContractStatus {
  PILOT
  ACTIVE
  PAUSED
  CANCELLED
}

enum PortfolioUploadStatus {
  RECEIVED
  PROCESSING
  DELIVERED
}

enum PortfolioDealContext {
  ACQUISITION_PIPELINE
  EXISTING_PORTFOLIO
  REHAB_PLANNING
  NEIGHBORHOOD_ASSESSMENT
}

model ClientEngagement {
  id                     String               @id @default(cuid())
  institution_name       String
  contact_name           String
  contact_email          String
  engagement_type        EngagementType
  monthly_fee            Int?
  per_deal_fee           Int?
  deal_volume_commitment Int?
  contract_start_date    DateTime
  contract_status        ClientContractStatus @default(PILOT)
  billing_notes          String?
  created_at             DateTime             @default(now())

  @@index([institution_name, created_at])
  @@index([contract_status, created_at])
}

model PortfolioUpload {
  id               String              @id @default(cuid())
  institution_name String
  contact_name     String
  contact_email    String
  addresses        String[]
  address_count    Int
  deal_context     PortfolioDealContext
  status           PortfolioUploadStatus @default(RECEIVED)
  reference_number String              @unique
  submitted_at     DateTime            @default(now())
  results_json     String?
  generated_at     DateTime?

  @@index([status, submitted_at])
  @@index([institution_name, submitted_at])
  @@index([reference_number])
}

model ExportLog {
  id          String   @id @default(cuid())
  userId      String
  exportType  String   // pdf, excel, csv
  resource    String   // scenario_comparison, commodity_report, etc.
  resourceId  String?
  fileSize    Int?
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([exportType])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([exportType, timestamp])
}

// ============================================
// BIS ENTITY LIST SCANNER
// ============================================

model ScanResult {
  id          String   @id @default(cuid())
  scanId      String   @unique

  // Company info
  companyName String
  email       String

  // Scan metadata
  fileType    String
  fileName    String?
  totalRows   Int
  skippedRows Int      @default(0)

  // Results summary
  totalSuppliers      Int
  clearSuppliers      Int      @default(0)
  lowRiskSuppliers    Int      @default(0)
  mediumRiskSuppliers Int      @default(0)
  highRiskSuppliers   Int      @default(0)
  criticalSuppliers   Int      @default(0)

  overallRiskLevel    String   // low, medium, high, critical
  overallRiskScore    Float    // 0-10
  estimatedExposure   String?

  // Full report data (JSON)
  fullReport          String   // JSON: ComplianceScanReport
  htmlReport          String   // HTML report
  textSummary         String?  // Plain text summary

  // Email delivery status
  emailSent           Boolean  @default(false)
  emailSentAt         DateTime?
  emailError          String?

  // Timestamps
  createdAt           DateTime @default(now())
  expiresAt           DateTime? // For automatic cleanup

  @@index([scanId])
  @@index([email])
  @@index([companyName])
  @@index([createdAt])
  @@index([email, createdAt])
  @@index([overallRiskLevel, createdAt])
  @@index([expiresAt])
}

// ============================================
// DISCOVERED OWNERSHIP DATA
// ============================================

model DiscoveredOwnership {
  id          String   @id @default(cuid())

  // Entity info
  entityName  String   @unique
  parentCompany String?

  // Relationships (JSON arrays)
  subsidiaries String  @default("[]") // JSON array of subsidiary names
  affiliates   String  @default("[]") // JSON array of affiliate names

  // Data quality
  confidence   Float   // 0-1
  dataQuality  String  // high, medium, low
  sources      String  // JSON array of source names

  // Evidence
  evidencePoints String @default("[]") // JSON array of evidence

  // Metadata
  lastUpdated  DateTime @updatedAt
  createdAt    DateTime @default(now())
  verified     Boolean  @default(false)
  verifiedBy   String?
  verifiedAt   DateTime?

  @@index([entityName])
  @@index([parentCompany])
  @@index([confidence])
  @@index([dataQuality])
  @@index([lastUpdated])
  @@index([verified])
}

// Background job tracking
model DiscoveryJob {
  id          String   @id @default(cuid())

  // Job info
  status      String   // pending, running, completed, failed
  type        String   // full_discovery, incremental_update, single_entity

  // Progress
  totalEntities    Int
  processedEntities Int @default(0)
  discoveredCount  Int @default(0)
  failedCount      Int @default(0)

  // Results
  coveragePercent  Float?
  results          String? // JSON

  // Error tracking
  errors           String? // JSON array of errors

  // Timestamps
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([startedAt])
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  dataType  String   @default("string") // string, number, boolean, json
  category  String   // api, feature_flags, limits, etc.
  updatedAt DateTime @updatedAt

  @@index([category])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  rollout     Float    @default(100) // Percentage rollout 0-100
  updatedAt   DateTime @updatedAt
}

enum OutreachStatus {
  NEW
  PACKET_GENERATED
  MAILED
  FOLLOW_UP
  CLOSED
}

model TargetStatus {
  id                String         @id @default(cuid())
  address           String
  normalizedAddress String
  zipCode           String
  status            OutreachStatus @default(NEW)
  notes             String?
  packetGeneratedAt DateTime?
  mailedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([normalizedAddress, zipCode], name: "target_status_unique")
  @@index([zipCode, status])
  @@index([updatedAt])
}

// ============================================
// PROCUREMENT INTELLIGENCE ONTOLOGY
// ============================================

enum ProcurementMethodType {
  EMERGENCY
  SOLE_SOURCE
  COMPETITIVE
  EXPEDITED
  SMALL_PROCUREMENT
  UNKNOWN
}

enum RiskBasisType {
  STRICT_LAW
  RISK_HEURISTIC
}

enum ConstraintLoopType {
  REGULATOR_PROCESS
  FINANCIAL
  ENTITY_OPACITY
  COMPLIANCE
}

enum ConstraintLoopStatus {
  ACTIVE
  BRIDGED
  BROKEN
}

enum BridgeInterventionType {
  PROCESS
  DATA
  CONTROL
}

enum BridgeInterventionStatus {
  PROPOSED
  DEPLOYED
  COMPLETED
  FAILED
}

model GovernmentAgency {
  id           String              @id @default(cuid())
  name         String              @unique
  jurisdiction String
  actions      ProcurementAction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([jurisdiction])
}

model MasterEntity {
  id         String             @id @default(cuid())
  name       String
  aliases    EntityAlias[]
  dossiers   RiskDossier[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([name])
}

model EntityAlias {
  id             String              @id @default(cuid())
  alias          String
  normalizedAlias String
  masterEntityId String
  masterEntity   MasterEntity        @relation(fields: [masterEntityId], references: [id], onDelete: Cascade)
  actions        ProcurementAction[]
  createdAt      DateTime            @default(now())

  @@index([masterEntityId])
  @@index([normalizedAlias])
  @@unique([masterEntityId, normalizedAlias])
}

model Statute {
  id         String             @id @default(cuid())
  code       String             @unique
  title      String
  bodyText   String
  sourceUrl  String
  dossiers   RiskDossier[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model ProcurementAction {
  id               String                @id @default(cuid())
  externalId       String?               @unique
  agencyId         String
  agency           GovernmentAgency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  aliasId          String
  alias            EntityAlias           @relation(fields: [aliasId], references: [id], onDelete: Cascade)
  amount           Float
  method           ProcurementMethodType
  category         String?
  startDate        DateTime?
  endDate          DateTime?
  waiverGranted    Boolean               @default(false)
  sourceUrl        String
  boardActionDate  DateTime?
  vendorAddress    String?
  vendorPhone      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([agencyId, method])
  @@index([aliasId, boardActionDate])
  @@index([boardActionDate])
  @@index([vendorAddress, vendorPhone])
}

model RiskDossier {
  id                 String        @id @default(cuid())
  snapshotId         String        @unique
  masterEntityId     String?
  masterEntity       MasterEntity? @relation(fields: [masterEntityId], references: [id], onDelete: SetNull)
  statuteId          String?
  statute            Statute?      @relation(fields: [statuteId], references: [id], onDelete: SetNull)
  agencyName         String
  basis              RiskBasisType
  indicator          String
  exposure           Float
  confidence         Float
  defensibilityScore Float
  sourceUrl          String
  generatedAt        DateTime      @default(now())

  @@index([agencyName, basis])
  @@index([generatedAt])
  @@index([defensibilityScore])
}

model ConstraintLoop {
  id           String               @id @default(cuid())
  signature    String               @unique
  type         ConstraintLoopType
  status       ConstraintLoopStatus @default(ACTIVE)
  signals      String               // JSON array of RiskFlag snapshots
  tensionScore Float                @default(0)
  vendor       String?
  agency       String?
  jurisdiction String?
  exposure     Float                @default(0)
  bridgedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  interventions BridgeIntervention[]

  @@index([type, status])
  @@index([vendor, status])
  @@index([updatedAt])
}

model BridgeIntervention {
  id               String                   @id @default(cuid())
  type             BridgeInterventionType
  status           BridgeInterventionStatus @default(PROPOSED)
  targetLoopId     String
  targetLoop       ConstraintLoop           @relation(fields: [targetLoopId], references: [id], onDelete: Cascade)
  playbookSteps    String                   // JSON array of BridgePlaybookStep
  expectedDelta    Float
  actualDelta      Float?
  timeToBridgeHours Float?
  deployedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([targetLoopId, status])
  @@index([createdAt])
}
